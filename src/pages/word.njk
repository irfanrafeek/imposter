{% from "components/head.njk" import head %}
{% from "components/icons.njk" import plane %}
{% from "components/faq.njk" import faq, faqJsonLd %}
{% from "components/howto.njk" import howto %}
{% from "components/more-reading.njk" import moreReading %}
{% from "components/alt-games.njk" import altGames %}
{% from "components/more-games-cta.njk" import moreGamesCta %}
{% from "components/jsonld.njk" import graph %}
{% from "components/lang-switch.njk" import langSwitch %}
<!DOCTYPE html>
<html lang="{{ locale.lang }}">
<head>
{{ head(c.head, page, site, url, locale, alternates, defaultUrl, manifestHref) }}
</head>
<body>
  <script type="application/ld+json">
  {{ graph(c.jsonldGraph, faqJsonLd(c.faq)) | safe }}
  </script>
  <div id="app">
    {# HOME SCREEN #}
    <section class="screen" id="screen-home">
      <div class="home-topbar">
        <a class="back-btn" href="{{ home }}" aria-label="{{ c.screens['home.back-to-all-games'] | safe }}">{{ c.screens['home.all-games'] | safe }}</a>
{{ langSwitch(alternates, t('lang.switcher-label')) }}
      </div>
      <div class="home-fold">
        <div class="logo">
{% include "partials/hero-juggler.svg" %}
          <h1>{{ c.screens['home.impostor-word-game'] | safe }}</h1>
          <div class="sub" id="app-version" hidden aria-hidden="true">{{ site.version }}</div>
        </div>

        <div class="eyebrow">{{ c.screens['home.create-or-join-the-game'] | safe }}</div>
        <div class="tile-grid">
          <button class="tile tile-stack" id="btn-create">
            <div class="tile-icon">
              <img src="/host.webp" alt="" width="80" height="80" />
            </div>
            <div class="tile-body">
              <div class="tile-title">{{ c.screens['home.create'] | safe }}</div>
              <div class="tile-sub">{{ c.screens['home.create-and-be-the-host'] | safe }}</div>
            </div>
          </button>

          <button class="tile tile-stack" id="btn-join-home">
            <div class="tile-icon">
              <img src="/player.webp" alt="" width="80" height="80" />
            </div>
            <div class="tile-body">
              <div class="tile-title">{{ c.screens['home.join'] | safe }}</div>
              <div class="tile-sub">{{ c.screens['home.join-an-existing-game'] | safe }}</div>
            </div>
          </button>
        </div>

        <button class="howto-anchor" id="howto-scroll" aria-label="{{ c.screens['home.jump-to-how-to-play'] | safe }}">
          {{ c.screens['home.how-to-play'] | safe }}
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      {# The first thing past the fold. The alt-games block at the bottom of
           the page does the same job, but it sits under the FAQ and almost
           nobody scrolls that far. A real <a> to the hub, so it is a crawlable
           internal link and middle-click works. #}
      {{ moreGamesCta(c.moreGamesCta, home) }}

      {{ howto(c.howto, "word") }}

        <div class="howto-cta">
          <button type="button" class="pill-btn" id="feedback-link">{{ c.ctaFeedback | safe }}</button>
        </div>

        <div class="howto-header" style="margin-top:48px;">
          <h2>{{ c.faq.heading | safe }}</h2>
        </div>
        {{ faq(c.faq.visible) }}

        {# Both of the blocks below are OPTIONAL, and /es/ leaves both out.
             The long-form guides are English-only, and so are the other two
             games, so a Spanish reader following either would land on a page
             they cannot read. A language ships these the day it has
             something in that language to point at (#139). #}
{% if c.moreReading %}
        <div class="howto-header more-reading-header">
          <h2>{{ c.moreReading.heading | safe }}</h2>
        </div>
        {{ moreReading(c.moreReading.links) }}
{% endif %}

        {# The other two games. Rows, not the hub's big cards: this is the
             foot of the page, under the FAQ. Icons are the lobby blink
             characters, loaded as <img> so each keeps its own animation and
             its own document, which is what stops the Figma ids inside them
             colliding with this page's inline hero. #}
{% if otherGames %}
        <div class="howto-header alt-games-header">
          <h2>{{ otherGames.heading | safe }}</h2>
        </div>
        {{ altGames(otherGames.games) }}
{% endif %}
      </section>

    </section>

    {# JOIN CODE SCREEN #}
    <section class="screen" id="screen-join-code">
      <button class="back-btn" data-back>{{ c.screens['join-code.back'] | safe }}</button>
      <div style="flex:1;"></div>
      <div class="join-title">
        <h2>{{ c.screens['join-code.room-code'] | safe }}</h2>
        <div class="sub">{{ c.screens['join-code.enter-room-code-to-join'] | safe }}</div>
      </div>
      <div class="code-boxes" id="code-boxes">
        <input type="text" class="code-box" data-idx="0" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
        <input type="text" class="code-box" data-idx="1" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
        <input type="text" class="code-box" data-idx="2" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
        <input type="text" class="code-box" data-idx="3" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
      </div>
      <div style="flex:2;"></div>
    </section>

    {# JOIN NAME SCREEN #}
    <section class="screen" id="screen-join-name">
      <button class="back-btn" data-back>{{ c.screens['join-code.back'] | safe }}</button>

      <div style="margin-top:24px;">
        <label class="field-label" for="join-name">{{ c.screens['join-name.name'] | safe }}</label>
        <input type="text" id="join-name" class="input-line" maxlength="14" placeholder="{{ c.screens['join-name.enter-nick-name'] | safe }}" autocomplete="off" />
      </div>

      <div style="flex:1;min-height:24px;"></div>

      <div class="sticky-actions">
        <button class="tile tile-action tile-dark" id="btn-join">
          <div class="tile-body">
            <div class="tile-title">{{ c.screens['join-name.enter-room'] | safe }}</div>
          </div>
          <svg class="tile-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    {# SETUP SCREEN (Host) #}
    <section class="screen" id="screen-setup">
      <button class="back-btn" data-back>{{ c.screens['join-code.back'] | safe }}</button>

      <div style="margin-top:24px;">
        <label class="field-label" for="host-name">{{ c.screens['join-name.name'] | safe }}</label>
        <input type="text" id="host-name" class="input-line" maxlength="14" placeholder="{{ c.screens['join-name.enter-nick-name'] | safe }}" autocomplete="off" />
      </div>

      <div style="flex:1;min-height:24px;"></div>

      <div class="sticky-actions">
        <button class="tile tile-action tile-dark" id="btn-go-lobby">
          <div class="tile-body">
            <div class="tile-title">{{ c.screens['setup.create-room'] | safe }}</div>
          </div>
          <svg class="tile-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    {# HOST SHARE-CODE SCREEN #}
    <section class="screen" id="screen-host-share">
      <button class="back-btn" data-back>{{ c.screens['host-share.leave'] | safe }}</button>

      <div class="share-wrap">
        <h1 class="share-title">{{ c.screens['host-share.room-created'] | safe }}</h1>
        <p class="share-hint">{{ c.screens['host-share.players-can-scan-or-enter'] | safe }}</p>
        {# QR, code and copy button in one card. #share-qr is .share-qr, not
             .qr-card: that class carries its own white fill and shadow, which
             the lobby QR modal still needs and this card does not. #}
        <div class="share-card">
          <p class="share-card-label">{{ c.screens['host-share.scan-code'] | safe }}</p>
          <div class="share-qr" id="share-qr"></div>
          <p class="share-card-label">{{ c.screens['host-share.or-enter-code'] | safe }}</p>
          <div class="share-code" id="share-code" title="{{ c.screens['host-share.copy-room-code'] | safe }}"></div>
          <button class="share-copy-btn" id="share-copy-btn" type="button">{{ c.screens['host-share.copy-code'] | safe }}</button>
        </div>
        {# Static text, not a link. The mode picker lives in the lobby, one
             screen further on, and switching from here would have to delete the
             room whose QR is on screen. #}
        <div class="share-or">{{ c.screens['host-share.or'] | safe }}</div>
        <p class="share-alt-hint">{{ c.screens['host-share.choose-pass-the-phone-mode'] | safe }}</p>
      </div>

      <div class="sticky-actions">
        <button class="tile tile-action tile-dark" id="btn-share-continue">
          <div class="tile-body">
            <div class="tile-title">{{ c.screens['host-share.go-to-lobby'] | safe }}</div>
          </div>
          <svg class="tile-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    {# LOBBY SCREEN #}
    <section class="screen" id="screen-lobby">
      <div class="lobby-topbar">
        <button class="back-btn" data-back id="lobby-back-btn">{{ t('lobby.leave-room') | safe }}</button>
        <button class="back-btn" id="lobby-howto-btn" type="button" aria-label="{{ c.screens['lobby.how-to-play'] | safe }}">{{ c.screens['lobby.how-to-play'] | safe }}</button>
      </div>
      <div class="lobby-head">
        <div class="lobby-head-title">
          {# Loaded as an <img> rather than inlined, which keeps it a separate
               document, so its #wj-* ids cannot collide with the inlined hero's.
               Sized by the shared .lobby-head-icon rule at 56px. #}
          <img class="lobby-head-icon" src="/word-cards-blink.svg" alt="" width="288" height="288" />
          <h1>{{ c.screens['lobby.lobby'] | safe }}</h1>
        </div>
        {# Hidden in Pass the Phone: there is no room to share into. #}
        <div class="code-row" id="lobby-code-row">
          <button class="code-chip" id="lobby-code-chip" title="{{ c.screens['host-share.copy-room-code'] | safe }}">
            <span id="lobby-code-text">----</span>
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="qr-btn" id="lobby-qr-btn" type="button" title="{{ c.screens['lobby.show-qr-code'] | safe }}" aria-label="{{ c.screens['lobby.show-qr-code'] | safe }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
              <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
              <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
              <rect x="14" y="14" width="3" height="3" rx="0.6" fill="currentColor"/>
              <rect x="18.5" y="14" width="2.5" height="2.5" rx="0.6" fill="currentColor"/>
              <rect x="14" y="18.5" width="2.5" height="2.5" rx="0.6" fill="currentColor"/>
              <rect x="18.5" y="18.5" width="2.5" height="2.5" rx="0.6" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="stack-lg">
        {# Game mode on top, thin divider, then the word category. Same card
             shape and the same components as the dance and draw lobbies.
             Game mode keeps a heading and a full-size trigger; the category
             is one row, because it is an adjustment rather than the decision
             that shapes the sitting. #}
        <div class="card mode-card settings-card">
          <div class="stack-sm mode-block" id="lobby-mode-section">
            <div class="cat-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h10M4 18h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              {{ c.screens['lobby.game-mode'] | safe }}
            </div>
            <button type="button" class="cat-trigger mode-trigger" id="mode-trigger">
              <span class="mode-trigger-inner">
                {{ c.screens['lobby.everyone-has-a-phone'] | safe }}
              </span>
              <svg class="cat-trigger-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>

          <div class="section-divider" id="lobby-mode-divider"></div>

          <button type="button" class="set-row" id="category-trigger">
            <span class="cat-label">{{ c.screens['lobby.category'] | safe }}</span>
            <span class="set-row-value" id="category-trigger-text">{{ t('category.Food.name') | safe }}</span>
            <svg class="cat-trigger-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          {# How many times the order goes round. Clue mode only: the
               original game and Pass the Phone have no turn order to
               repeat, so the whole row leaves with them (#258). #}
          <div class="section-divider" id="rounds-divider" style="display:none;"></div>

          <div class="set-row" id="rounds-section" style="display:none;">
            <span class="cat-label">{{ c.screens['lobby.rounds'] | safe }}</span>
            <div class="rounds-pill" id="rounds-pill">
              <button id="lobby-rounds-minus" type="button" aria-label="{{ c.screens['lobby.fewer-rounds'] | safe }}" style="display:none;">−</button>
              <span class="rounds-label">{{ c.screens['lobby.2-rounds'] | safe }}</span>
              <button id="lobby-rounds-plus" type="button" aria-label="{{ c.screens['lobby.more-rounds'] | safe }}" style="display:none;">+</button>
            </div>
          </div>

          <div class="section-divider" id="imposters-divider"></div>

          {# Last row: how many impostors. A setting, so it belongs here with
               the mode and the category rather than in the header of the
               Players card, where it used to sit and read as a fact about the
               roster. Non-hosts see the value with the steppers hidden, the
               same way the rows above lose their chevrons. #}
          <div class="set-row" id="imposters-section">
            <span class="cat-label">{{ c.screens['lobby.impostors'] | safe }}</span>
            <div class="imposter-pill" id="imposter-info">
              <button id="lobby-imp-minus" type="button" aria-label="{{ c.screens['lobby.fewer-impostors'] | safe }}" style="display:none;">−</button>
              <span class="imp-label">{{ c.screens['lobby.1-impostor'] | safe }}</span>
              <button id="lobby-imp-plus" type="button" aria-label="{{ c.screens['lobby.more-impostors'] | safe }}" style="display:none;">+</button>
            </div>
          </div>
        </div>

        {# A player's lobby clock (#275). The host's sits over Start Game in
             the sticky bar; a player has no button there, so theirs sits in
             the page between the settings and the roster. #}
        <div class="phase-clock" id="lobby-clock-player" aria-live="off" hidden></div>

        {# The id is here for the chat pill, which floats over this card's
             bottom right corner on a lobby long enough to scroll. The room
             it needs is taken outside the card rather than inside it, so a
             short lobby shows no dead space at all (#246). #}
        <div class="card" id="lobby-players-card">
          <div class="players-head">
            <div class="label">{{ c.screens['lobby.players'] | safe }}</div>
            {# Ready count for the room game; a plain head count for Pass
                 the Phone, where nobody readies up. Only ever one of the two
                 is showing, so the right-hand side is always a single line. #}
            <div class="small" id="lobby-ready-line">{{ c.screens['lobby.0-0-ready'] | safe }}</div>
            <div class="small" id="lobby-count-line" style="display:none;">{{ c.screens['lobby.0-players'] | safe }}</div>
            {# An online game has no ready step, so its right-hand side is the
                 head count, written by renderLobby because it needs a plural (#275). #}
            <div class="small" id="lobby-online-line" style="display:none;"></div>
          </div>
          <div class="players" id="players-list"></div>
        </div>

        <div class="sticky-actions">
          {# The online game's clock (#275): the round starts, or the room
               closes, when it runs out. Filled in by the room's own ticker. #}
          <div class="phase-clock" id="lobby-clock" aria-live="off" hidden></div>
          <div class="ready-nudge" id="ready-nudge">
            <button class="btn btn-primary" id="btn-ready">{{ t('lobby.im-ready') | safe }}</button>
          </div>
          <button class="btn btn-primary" id="btn-start" disabled>{{ c.screens['lobby.start-game'] | safe }}</button>
          <div class="small center" id="start-hint">{{ c.screens['lobby.waiting-for-all-players-to'] | safe }}</div>
        </div>
      </div>
    </section>

    {# GAMEPLAY SCREEN — the card is dealt face up, counts itself down and
         then turns over, leaving the quiet game-on state behind it (#144).
         The card is the same rectangle it has always been; only the turning
         is borrowed from Pass the Phone. #}
    <section class="screen" id="screen-game">
      <button class="back-btn" type="button" id="game-quit-btn">{{ t('lobby.quit-game') | safe }}</button>

      <div style="flex:0.5;min-height:16px;"></div>

      <div class="flip-scene">
        <div class="flip-card is-plate" id="game-plate" role="button" tabindex="0" aria-pressed="true">
          {# The face that is IN FLOW, because it is the taller of the two and
               its height is what the pair has to be. #}
          <div class="plate-face plate-up word-card" id="word-card">
            <div class="imposter-banner" id="imposter-banner">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/><path d="M12 8v5M12 16v.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
              {{ c.screens['card.you-are-the-impostor'] | safe }}
            </div>
            <div class="role" id="game-role">{{ t('card.role-word') | safe }}</div>
            <div class="word-big" id="game-word">—</div>
            <div class="card-countdown" id="game-countdown" aria-hidden="true"></div>
          </div>
          <div class="plate-face plate-down card">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <path d="M10.6 6.2A9.6 9.6 0 0112 6c5 0 9 4.5 9 6 0 .7-.9 2.1-2.4 3.4M6.4 8.5C4.2 9.9 3 11.5 3 12c0 1.5 4 6 9 6 1.3 0 2.5-.3 3.6-.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <path d="M9.9 9.9a3 3 0 004.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <div class="small">{{ c.screens['game.swipe-to-check-your-card'] | safe }}</div>
          </div>
        </div>
      </div>

      {# Keeps its box from the first paint, so the card does not shift when
           the round goes live under it. #}
      <div class="game-status" id="game-status">
        <div class="status-line"><span class="live-dot" aria-hidden="true"></span>{{ c.screens['game.game-on'] | safe }}</div>
        <div class="game-timer" id="game-clock" role="timer" aria-live="off">00:00</div>
      </div>

      <div style="flex:1;min-height:16px;"></div>

      <div class="game-foot" style="margin-top:auto;">
        <div class="small center game-hint" id="game-hint">{{ c.screens['game.take-turns-saying-one-clue'] | safe }}</div>
        <button class="btn btn-danger" id="btn-reveal" style="display:none;">{{ c.screens['game.reveal-impostor'] | safe }}</button>
        <div class="small center reveal-note" id="game-reveal-note" style="display:none;">{{ c.screens['game.tap-reveal-when-the-round'] | safe }}</div>
      </div>
    </section>

    {# CLUE BOARD — the whole round, for a room that is not in one room
         (#244). The turn order runs down the board instead of round a
         table: one clue each, thirty seconds a turn, oldest at the top.

         The card is up the whole time and does not turn over. Every other
         card in this game hides itself because the people you are playing
         with can see your screen; here they are somewhere else entirely,
         and a word you have to remember for ten minutes is a worse game,
         not a fairer one.

         The pill, the top bar and the turn strip are the drawing game's,
         from shared/base.css. What the strip does NOT carry is the ink
         dot: a clue is a piece of text with a person attached, so the row
         names its author outright rather than coding them by colour. #}
    <section class="screen screen-clues" id="screen-clues">
      <div class="play-topbar">
        <button class="back-btn" type="button" id="clues-quit-btn">{{ t('lobby.quit-game') | safe }}</button>
        <div class="topbar-right">
          <div class="turn-pill no-timer" id="turn-pill">
            <span class="turn-label" id="turn-label">{{ t('turn.getting-ready') | safe }}</span>
            <span class="turn-timer" id="turn-timer"></span>
          </div>
          {# Mutes the turn clock. Four phones in one room is four clocks. #}
          <button class="sound-btn" id="btn-sound" type="button" aria-pressed="false" aria-label="{{ c.screens['clues.mute-turn-sound'] | safe }}"></button>
        </div>
      </div>

      <div class="clue-card word-card" id="clue-card">
        <div class="imposter-banner" id="clue-banner">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/><path d="M12 8v5M12 16v.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          {{ c.screens['card.you-are-the-impostor'] | safe }}
        </div>
        <div class="role" id="clue-role">{{ t('card.role-word') | safe }}</div>
        <div class="word-big clue-word" id="clue-secret">—</div>
      </div>

      {# The field is not part of the board. It turns up between the secret
           word and the clues when the turn is yours and leaves when it is
           not, so on everybody else's turn the panel carries clues and
           nothing else (#254). #}
      <div class="clue-stage">
        <div class="clue-dockwrap" id="clue-dock" hidden>
          <div class="clue-dock">
            <form class="card clue-composer" id="clue-composer">
              {# The countdown is a drawn stroke rather than a border, because
                   only a dash can empty an outline evenly round its own
                   corners. Both rectangles are sized in script: the dash has
                   to be the real perimeter of the box, and the box is fluid. #}
              <svg class="clue-ring" id="clue-ring" aria-hidden="true">
                <rect class="clue-ring-track"/>
                <rect class="clue-ring-live" id="clue-ring-live"/>
              </svg>
              <input class="clue-input" id="clue-input" type="text" inputmode="text"
                     autocomplete="off" autocapitalize="sentences" spellcheck="false"
                     maxlength="30" aria-label="{{ c.screens['clues.your-clue'] | safe }}"
                     placeholder="{{ c.screens['clues.your-clue'] | safe }}">
              {# The counter lives in the box rather than on a line under it.
                   A reserved line below the field would stand between the
                   field and the board, and the two are now 8px apart (#256). #}
              <span class="clue-count" id="clue-count" aria-hidden="true"></span>
              {# The chat composer's button, not a second one drawn to look
                   like it: same class, same icon, same size (#257). #}
              <button class="send-btn" id="clue-send" type="submit" disabled
                      aria-label="{{ c.screens['clues.send'] | safe }}">
                {{ plane() }}
              </button>
            </form>
            <div class="clue-note" id="clue-note" role="status"></div>
          </div>
        </div>

        <div class="card clue-panel">
          {# The play order rides on top of the board rather than above it,
               so the room and what the room has written are one object. The
               writer is pulled to the front by CSS order alone, which leaves
               this list, and so the reading order, in play order (#255). #}
          <div class="turn-strip" id="turn-strip" aria-label="{{ c.screens['clues.turn-order'] | safe }}"></div>

          {# Two facts a player would otherwise have to work out by counting:
               how many are in the round, and how far through it the room is.
               The round wears a soft pill because it is the number on this
               line that actually moves (#259). #}
          <div class="board-meta">
            <span id="board-players">{{ t('board.players', { count: 0 }) | safe }}</span>
            <span class="board-round" id="board-round">{{ t('board.round', { round: 1, total: 1 }) | safe }}</span>
          </div>

          {# Above the board rather than inside it: an <ol> holds list items
               and nothing else, and a line stranded at the bottom of an empty
               scroller reads as a footer rather than as a waiting board. #}
          <div class="clue-empty small center" id="clue-empty">{{ c.screens['clues.board-empty'] | safe }}</div>
          <ol class="clue-board" id="clue-board"></ol>
        </div>
      </div>
    </section>

    {# PASS THE PHONE — one card with two sides, turned over by hand.
         The back is empty until a swipe is underway: see the pass-sequence
         section in app.js for why that matters and when it gets filled. #}
    <section class="screen" id="screen-pass-card">
      <div class="pass-step" id="pass-step">&nbsp;</div>

      <div style="flex:1;min-height:16px;"></div>

      <div class="flip-scene" id="pass-scene">
        <div class="flip-card" id="flip-card">
          <button type="button" class="card flip-face flip-front" id="flip-front">
            <div class="pass-avatar" id="pass-avatar"></div>
            <div class="pass-name" id="pass-name">—</div>
            <div class="small pass-note">{{ c.screens['pass-card.swipe-to-reveal'] | safe }}</div>
          </button>
          {# The badge rides on the card, as it does in the online game. Above
               the card it used to appear at 45 degrees of the swipe, which is
               before this face is anywhere near visible (#144). #}
          <div class="flip-face flip-back word-card" id="flip-back">
            <div class="imposter-banner" id="pass-banner">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/><path d="M12 8v5M12 16v.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
              {{ c.screens['card.you-are-the-impostor'] | safe }}
            </div>
            <div class="role" id="pass-role"></div>
            <div class="word-big" id="pass-word"></div>
          </div>
        </div>
      </div>

      <div style="flex:1;min-height:16px;"></div>

      <div class="stack-sm" style="margin-top:auto;">
        {# Reads "Start Playing" on the last card, which has nobody to pass to. #}
        <button class="btn btn-primary" id="btn-pass-next">{{ t('pass.pass-to-next') | safe }}</button>
      </div>
    </section>

    {# PASS THE PHONE — the round itself. This one sits face-up in the
         middle of the group for the whole round, so there is nothing on it
         but names: no word, no hint, nothing marking the impostor. #}
    <section class="screen" id="screen-pass-round">
      <button class="back-btn" type="button" id="pass-round-quit-btn">{{ t('lobby.quit-game') | safe }}</button>
      <div class="logo">
        <img class="headphones" src="/game-word-playing.webp" alt="" width="500" height="345" />
        <h1>{{ c.screens['pass-round.game-is-on'] | safe }}</h1>
        {# Counts up from the moment the last card was put away, which on one
             phone is the only start there is. Nothing is being played before
             then, so it is the honest zero. #}
        <div class="game-timer" id="pass-round-clock" role="timer" aria-live="off">00:00</div>
      </div>

      <div class="card">
        <div class="label" style="margin-bottom:14px;">{{ c.screens['lobby.players'] | safe }}</div>
        <div class="players" id="pass-round-players"></div>
      </div>

      <div style="flex:1;min-height:16px;"></div>

      <div class="stack-sm" style="margin-top:auto;">
        <button class="btn btn-danger" id="btn-pass-reveal">{{ c.screens['game.reveal-impostor'] | safe }}</button>
        <div class="small center">{{ c.screens['pass-round.take-turns-saying-one-clue'] | safe }}</div>
      </div>
    </section>

    {# FIREBASE SETUP NEEDED SCREEN

         DELIBERATELY ENGLISH-ONLY, in every language. Nobody playing the game
         can reach this: it shows only when FB_CONFIGURED is false, which means
         a fresh clone with no config. Its audience is whoever is setting the
         project up, and it walks them through an English console and an
         English README, so translating it would make it harder to follow, not
         easier. The literal-string scan in #139 flags this block; this note is
         why it stays flagged. #}
    {# VOTE SCREEN  (#245)
         The names first, because that is what the screen is for, and the
         board under them, because the board is the argument: a round of
         clues is a page of evidence and nobody remembers six words under
         pressure.

         The heading is the instruction rather than a question, so the line
         that used to repeat it above the list is gone.

         One pick per impostor in the round. Nothing on this screen ever says
         who anybody picked: a ballot on show would be a tell. #}
    <section class="screen screen-vote" id="screen-vote">
      <button class="back-btn" id="vote-back-btn" type="button">{{ c.screens['host-share.leave'] | safe }}</button>

      <div class="vote-head">
        <h2 class="vote-title" id="vote-title">{{ plural('vote.heading', 1) | safe }}</h2>
        <div class="small center" id="vote-sub">{{ t('vote.sub-pick') | safe }}</div>
        <div class="phase-clock" id="vote-clock" aria-live="off" hidden></div>
      </div>

      {# One card holding one bordered box per name, shaped like the board
           below it so the two read as a pair. #}
      <div class="vote-list is-boxed" id="vote-list" role="group" aria-labelledby="vote-title"></div>

      <div class="over-label vote-clues-label">{{ c.screens['vote.the-clues'] | safe }}</div>

      {# Neither card scrolls inside itself: the screen scrolls, and the
           button below stays on it. #}
      <div class="card vote-evidence">
        <ol class="clue-board" id="vote-board"></ol>
      </div>

      <div class="sticky-actions">
        <div class="small center" id="vote-hint">—</div>
      </div>
    </section>

    {# REVEAL COUNTDOWN — three seconds of nothing but the question, so the
         answer lands on a held breath. Nothing to press. #}
    <section class="screen screen-suspense" id="screen-reveal">
      <div class="suspense-line" id="reveal-suspense">{{ plural('reveal.impostor-is', 1) | safe }}</div>
      <div class="suspense-num" id="reveal-count"></div>
    </section>

    <section class="screen" id="screen-needs-setup">
      <button class="back-btn" data-back>{{ c.screens['join-code.back'] | safe }}</button>
      <div class="logo">
        <h1 style="font-size:24px;">⚙️ Setup Needed</h1>
        <div class="sub">configure firebase</div>
      </div>
      <div class="card stack">
        <p>To enable real multiplayer, add a free Firebase project:</p>
        <ol style="margin-left:20px;line-height:1.8;font-size:14px;color:var(--text-dim);">
          <li>Go to <b style="color:#fff;">console.firebase.google.com</b></li>
          <li>Create a new project</li>
          <li>Build → <b style="color:#fff;">Realtime Database</b> → Create (test mode)</li>
          <li>Project settings → Add <b style="color:#fff;">Web app</b> → copy config</li>
          <li>Paste config into <code style="background:rgba(0,0,0,0.4);padding:2px 6px;border-radius:4px;">FIREBASE_CONFIG</code> at the top of <code style="background:rgba(0,0,0,0.4);padding:2px 6px;border-radius:4px;">index.html</code></li>
        </ol>
        <p class="small">See <b>README.md</b> for full instructions and database security rules.</p>
      </div>
    </section>

    {# GAME OVER SCREEN #}
    <section class="screen" id="screen-over">
      <div class="logo">
        {# Rewritten at the reveal for a round that had a ballot. A round
             played on one phone, or a classic online round, keeps this
             heading: those are settled out loud, not by a vote (#245). #}
        <h1 id="verdict-title">{{ c.screens['over.round-over'] | safe }}</h1>
        <div class="sub" id="verdict-sub"></div>
      </div>

      <div style="flex:1;min-height:16px;"></div>

      <div class="card reveal-card">
        {# One string, not three spans. revealImposter() rewrites the whole
             line: a round can have up to five impostors, and in Spanish the
             article, the noun and the verb all have to agree, which no
             arrangement of fixed spans can do. Draw keeps its as static
             markup: it deals exactly one, by design. #}
        <div class="reveal-line" id="reveal-line">{{ plural('over.impostor-was', 1) | safe }}</div>
        <div class="reveal-name" id="reveal-name">—</div>
      </div>

      {# Online games only: the next round, or the room closing (#275). Right
           under the answer rather than with the buttons, so it is on the
           first screenful of a phone and nobody is surprised by the move. #}
      <div class="phase-clock over-clock" id="over-clock" aria-live="off" hidden></div>

      <div class="reveal-extras">
        <div class="track-section">
          <div class="track-label crew">{{ c.screens['over.the-secret-word-was'] | safe }}</div>
          <div class="reveal-word" id="reveal-word">—</div>
        </div>
      </div>

      {# Both sections belong to the clue board's ballot and are hidden
           everywhere else. How it ended, then by how much, then exactly who
           did it (#245). #}
      <div class="over-section" id="over-tally-section">
        <div class="over-label">{{ c.screens['over.votes'] | safe }}</div>
        <div class="tally" id="tally-list"></div>
      </div>

      <div class="over-section" id="over-ballot-section">
        <div class="over-label">{{ c.screens['over.who-voted-whom'] | safe }}</div>
        <div class="ballot-list" id="ballot-list"></div>
      </div>

      <div style="flex:1;min-height:32px;"></div>

      <div class="stack-sm">
        <button class="btn btn-primary" id="btn-replay">{{ c.screens['over.play-again'] | safe }}</button>
        <button class="btn btn-ghost" id="btn-home">{{ t('over.exit-room') | safe }}</button>
      </div>
    </section>
  </div>

  {# Round-milestone support popup. Sits after the feedback popup because it
     comes second in a player's life on the site: rate at 8 rounds, and only
     someone still here at 20 gets asked for a coffee. One nudge per Round
     Over, and this one waits for the feedback popup to be answered. #}
  <div class="cat-modal-backdrop" id="coffee-backdrop" role="dialog" aria-modal="true" aria-label="{{ c.screens['app.having-a-good-time'] | safe }}">
    <div class="cat-modal fbp-card">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="coffee-close" type="button" aria-label="{{ c.screens['app.close'] | safe }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="fbp-body">
        <div class="fbp-title">{{ c.screens['app.having-a-good-time-2'] | safe }}</div>
        <p class="coffee-text">{{ c.screens['app.your-support-helps-keep'] | safe }}</p>
        {# An <a>, not a button: this leaves the site, so it should read as a
           link to the browser and offer the long-press menu a link offers. #}
        <a class="btn btn-primary coffee-cta" id="coffee-cta" href="https://buymeacoffee.com/irfanrafeek" target="_blank" rel="noopener noreferrer">{{ c.screens['app.buy-me-a-coffee'] | safe }}</a>
        <button type="button" class="feedback-link" id="coffee-later">{{ c.screens['app.not-now'] | safe }}</button>
      </div>
    </div>
  </div>

  {# Round-milestone feedback popup #}
  <div class="cat-modal-backdrop" id="fbp-backdrop" role="dialog" aria-modal="true" aria-label="{{ c.screens['app.enjoying-the-game'] | safe }}">
    <div class="cat-modal fbp-card">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="fbp-close" type="button" aria-label="{{ c.screens['app.close'] | safe }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="fbp-body">
        <div class="fbp-title" id="fbp-title">{{ c.screens['app.enjoying-the-game-2'] | safe }}</div>
        <div class="fb-emojis" id="fb-emojis">
          <button type="button" class="fb-emoji" data-rating="1" aria-label="{{ c.screens['app.not-great'] | safe }}">😕</button>
          <button type="button" class="fb-emoji" data-rating="2" aria-label="{{ c.screens['app.it-s-okay'] | safe }}">😐</button>
          <button type="button" class="fb-emoji" data-rating="3" aria-label="{{ c.screens['app.good'] | safe }}">😄</button>
          <button type="button" class="fb-emoji" data-rating="4" aria-label="{{ c.screens['app.love-it'] | safe }}">🤩</button>
        </div>
        {# The second half of the popup: a face is tapped, the faces give way
           to this and a sent note hands straight over to the chat panel, so
           there is no third screen to read past (#197). #}
        <div class="fbp-say" id="fbp-say" hidden>
          <div class="fbp-say-lead">{{ c.screens['app.help-us-improve'] | safe }}</div>
          <div class="chat-composer">
            <textarea class="chat-field" id="fbp-field" rows="4" maxlength="1000"
              placeholder="{{ c.screens['app.what-should-we-make-better'] | safe }}"
              aria-label="{{ c.screens['app.your-feedback'] | safe }}"></textarea>
            <button type="button" class="send-btn" id="fbp-send" disabled aria-label="{{ c.screens['app.send'] | safe }}">
              {{ plane() }}
            </button>
          </div>
          <div class="chat-err" id="fbp-err" hidden></div>
        </div>
      </div>
    </div>
  </div>

  {# Countdown overlay #}
  <div class="countdown" id="countdown">
    <div class="num" id="countdown-num">3</div>
  </div>

  {# The beat between the last clue and the ballot. Two seconds, no buttons:
       long enough to register the change of gear, short enough that nobody
       reaches for the screen. The vote screen is built and live underneath
       it the whole time (#245). #}
  <div class="countdown vote-intro" id="vote-intro" role="status">
    <div class="vote-intro-text">{{ c.screens['app.time-to-find-the-impostor'] | safe }}</div>
  </div>

  {# Toast #}
  <div class="toast" id="toast"></div>

  {# Game-mode picker modal #}
  <div class="cat-modal-backdrop" id="mode-modal-backdrop" role="dialog" aria-modal="true" aria-label="{{ c.screens['mode-modal.pick-a-game-mode'] | safe }}">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="mode-modal-close" type="button" aria-label="{{ c.screens['app.close'] | safe }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="cat-modal-list" id="mode-modal-list"></div>
    </div>
  </div>

  {# Category picker modal #}
  <div class="cat-modal-backdrop" id="cat-modal-backdrop" role="dialog" aria-modal="true" aria-label="{{ c.screens['cat-modal.pick-word-categories'] | safe }}">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-select-btn" id="cat-select-btn" type="button">{{ t('cat.select') | safe }}</button>
        <button class="cat-modal-close" id="cat-modal-close" type="button" aria-label="{{ c.screens['app.close'] | safe }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="cat-modal-list" id="cat-modal-list"></div>
      <div class="cat-modal-footer" id="cat-modal-footer" style="display:none;">
        <button class="cat-done" id="cat-modal-done" type="button">{{ c.screens['cat-modal-done.done'] | safe }}</button>
      </div>
    </div>
  </div>


  {# Lobby QR popup #}
  <div class="cat-modal-backdrop" id="qr-modal-backdrop" role="dialog" aria-modal="true" aria-label="{{ c.screens['qr-modal.room-qr-code'] | safe }}">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="qr-modal-close" type="button" aria-label="{{ c.screens['app.close'] | safe }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="qr-modal-body">
        <p class="qr-modal-hint">{{ c.screens['qr-modal.scan-to-join-this-room'] | safe }}</p>
        <div class="qr-card" id="lobby-qr-card"></div>
        <div class="qr-modal-code" id="lobby-qr-code">----</div>
      </div>
    </div>
  </div>

  {# How-to-play popup (in-lobby) #}
  <div class="cat-modal-backdrop" id="howto-modal-backdrop" role="dialog" aria-modal="true" aria-label="{{ c.screens['lobby.how-to-play'] | safe }}">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <h2 class="cat-modal-title">{{ c.screens['lobby.how-to-play'] | safe }}</h2>
        <button class="cat-modal-close" id="howto-modal-close" type="button" aria-label="{{ c.screens['app.close'] | safe }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="cat-modal-list" id="howto-modal-body"></div>
    </div>
  </div>

  {# Quitting mid-round. The backdrop is the sheet backdrop every other modal
       here uses; only the sheet inside it is new, because a confirm is a
       question and two buttons rather than a scrolling list. Title, body and
       the destructive label are all written by app.js: what quitting costs
       depends on whether you hold the room, are a guest in someone else's, or
       are the one phone the whole group is sharing (#144). #}
  <div class="cat-modal-backdrop" id="quit-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="quit-modal-title">
    <div class="confirm-sheet">
      <h2 class="confirm-title" id="quit-modal-title"></h2>
      <p class="confirm-body" id="quit-modal-body"></p>
      <div class="confirm-actions">
        <button class="confirm-cancel" type="button" id="quit-modal-cancel">{{ c.screens['quit-modal.cancel'] | safe }}</button>
        <button class="confirm-go" type="button" id="quit-modal-go"></button>
      </div>
    </div>
  </div>

{# qrcode-generator v1.4.4 by Kazuhiko Arase (MIT) — vendored in shared/qrcode.js, no runtime CDN dependency. Exposes window.qrcode. #}
<script src="/shared/qrcode.js"></script>
<script src="/shared/press.js"></script>
{% include "components/i18n.njk" %}
<script type="module" src="/word/app.js"></script>
</body>
</html>
