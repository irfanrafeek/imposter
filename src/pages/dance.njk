{% from "components/head.njk" import head %}
{% from "components/faq.njk" import faq, faqJsonLd %}
{% from "components/howto.njk" import howto %}
{% from "components/more-reading.njk" import moreReading %}
{% from "components/alt-games.njk" import altGames %}
{% from "components/more-games-cta.njk" import moreGamesCta %}
{% from "components/jsonld.njk" import graph %}
<!DOCTYPE html>
<html lang="{{ locale.lang }}">
<head>
{{ head(c.head, page, site, url, locale) }}
</head>
<body>
  <script type="application/ld+json">
  {{ graph(c.jsonldGraph, faqJsonLd(c.faq)) | safe }}
  </script>
  <div id="app">
    <!-- HOME SCREEN -->
    <section class="screen" id="screen-home">
      <div class="home-topbar">
        <a class="back-btn" href="/" aria-label="Back to all games">← All games</a>
        <div id="account-slot" class="account-slot"></div>
      </div>
      <div class="home-fold">
        <div class="logo">
{% include "partials/hero-dancer.svg" %}
          <h1>Impostor<br/>Dance Game</h1>
          <div class="sub" id="app-version" hidden aria-hidden="true">{{ site.version }}</div>
        </div>

        <div class="eyebrow">Create or Join the game</div>
        <div class="tile-grid">
          <button class="tile tile-stack" id="btn-create">
            <div class="tile-icon">
              <img src="/host.webp" alt="" width="80" height="80" />
            </div>
            <div class="tile-body">
              <div class="tile-title">Create</div>
              <div class="tile-sub">Create and be the host</div>
            </div>
          </button>

          <button class="tile tile-stack" id="btn-join-home">
            <div class="tile-icon">
              <img src="/player.webp" alt="" width="80" height="80" />
            </div>
            <div class="tile-body">
              <div class="tile-title">Join</div>
              <div class="tile-sub">Join an existing game</div>
            </div>
          </button>
        </div>

        <button class="howto-anchor" id="howto-scroll" aria-label="Jump to How to Play">
          How to play
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <!-- The first thing past the fold. The alt-games block at the bottom of
           the page does the same job, but it sits under the FAQ and almost
           nobody scrolls that far. A real <a> to the hub, so it is a crawlable
           internal link and middle-click works. -->
      {{ moreGamesCta(c.moreGamesCta) }}

      {{ howto(c.howto) }}

        <p class="howto-def" style="margin-top:24px;"><strong>Two ways to play.</strong> In <strong>Imposter Challenge</strong>, the host picks a music category and the app plays a random song each round while the host dances along. In <strong>DJ Mode</strong>, the host searches for the exact song the group hears, sits out, and watches as game master, perfect when you want to control the playlist and catch the impostor yourself.</p>

        <div class="howto-cta">
          <button type="button" class="pill-btn" id="feedback-link">{{ c.ctaFeedback | safe }}</button>
        </div>

        <div class="howto-header" style="margin-top:48px;">
          <h2>{{ c.faq.heading | safe }}</h2>
        </div>
        {{ faq(c.faq.visible) }}

        <div class="howto-header more-reading-header">
          <h2>{{ c.moreReading.heading | safe }}</h2>
        </div>
        {{ moreReading(c.moreReading.links) }}

        <!-- The other two games. Rows, not the hub's big cards: this is the
             foot of the page, under the FAQ. Icons are the lobby blink
             characters, loaded as <img> so each keeps its own animation and
             its own document, which is what stops the Figma ids inside them
             colliding with this page's inline hero. -->
        <div class="howto-header alt-games-header">
          <h2>{{ c.altGames.heading | safe }}</h2>
        </div>
        {{ altGames(c.altGames.games, site) }}
      </section>

    </section>

    <!-- JOIN CODE SCREEN -->
    <section class="screen" id="screen-join-code">
      <button class="back-btn" data-back>← Back</button>
      <div style="flex:1;"></div>
      <div class="join-title">
        <h2>Room Code</h2>
        <div class="sub">Enter room code to join game</div>
      </div>
      <div class="code-boxes" id="code-boxes">
        <input type="text" class="code-box" data-idx="0" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
        <input type="text" class="code-box" data-idx="1" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
        <input type="text" class="code-box" data-idx="2" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
        <input type="text" class="code-box" data-idx="3" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="X" />
      </div>
      <div style="flex:2;"></div>
    </section>

    <!-- JOIN NAME SCREEN -->
    <section class="screen" id="screen-join-name">
      <button class="back-btn" data-back>← Back</button>

      <div style="margin-top:24px;">
        <label class="field-label" for="join-name">Name</label>
        <input type="text" id="join-name" class="input-line" maxlength="14" placeholder="Enter Nick Name" autocomplete="off" />
      </div>

      <div style="flex:1;min-height:24px;"></div>

      <div class="sticky-actions">
        <button class="tile tile-action tile-dark" id="btn-join">
          <div class="tile-body">
            <div class="tile-title">Enter room</div>
          </div>
          <svg class="tile-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- SETUP SCREEN (Host) -->
    <section class="screen" id="screen-setup">
      <button class="back-btn" data-back>← Back</button>

      <div style="margin-top:24px;">
        <label class="field-label" for="host-name">Name</label>
        <input type="text" id="host-name" class="input-line" maxlength="14" placeholder="Enter Nick Name" autocomplete="off" />
      </div>

      <div style="flex:1;min-height:24px;"></div>

      <div class="sticky-actions">
        <button class="tile tile-action tile-dark" id="btn-go-lobby">
          <div class="tile-body">
            <div class="tile-title">Create Room</div>
          </div>
          <svg class="tile-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- HOST SHARE-CODE SCREEN -->
    <section class="screen" id="screen-host-share">
      <button class="back-btn" data-back>← Leave</button>

      <div class="share-wrap">
        <h1 class="share-title">Room Created! 🎉</h1>
        <p class="share-hint">Players can scan or enter the code to join.</p>
        <!-- QR, code and copy button in one card. #share-qr is .share-qr, not
             .qr-card: that class carries its own white fill and shadow, which
             the lobby QR modal still needs and this card does not. -->
        <div class="share-card">
          <p class="share-card-label">Scan code</p>
          <div class="share-qr" id="share-qr"></div>
          <p class="share-card-label">or enter code</p>
          <div class="share-code" id="share-code" title="Copy room code"></div>
          <button class="share-copy-btn" id="share-copy-btn" type="button">Copy code</button>
        </div>
      </div>

      <div class="sticky-actions">
        <button class="tile tile-action tile-dark" id="btn-share-continue">
          <div class="tile-body">
            <div class="tile-title">Go to Lobby</div>
          </div>
          <svg class="tile-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- LOBBY SCREEN -->
    <section class="screen" id="screen-lobby">
      <div class="lobby-topbar">
        <button class="back-btn" data-back id="lobby-back-btn">← Leave Room</button>
        <button class="back-btn" id="lobby-howto-btn" type="button" aria-label="How to play">How to play</button>
      </div>
      <div class="lobby-head">
        <div class="lobby-head-title">
          <img class="lobby-head-icon lobby-head-char" src="/characterdance-blink.svg" alt="" width="356" height="370" />
          <h1>Lobby</h1>
        </div>
        <div class="code-row">
          <button class="code-chip" id="lobby-code-chip" title="Copy room code">
            <span id="lobby-code-text">----</span>
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="qr-btn" id="lobby-qr-btn" type="button" title="Show QR code" aria-label="Show QR code">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
              <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
              <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
              <rect x="14" y="14" width="3" height="3" rx="0.6" fill="currentColor"/>
              <rect x="18.5" y="14" width="2.5" height="2.5" rx="0.6" fill="currentColor"/>
              <rect x="14" y="18.5" width="2.5" height="2.5" rx="0.6" fill="currentColor"/>
              <rect x="18.5" y="18.5" width="2.5" height="2.5" rx="0.6" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="stack-lg">
        <div class="card mode-music-card settings-card" id="mode-music-card">
          <div class="stack-sm mode-section mode-block" id="mode-section">
            <div class="cat-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h10M4 18h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              Game Mode
            </div>
            <button type="button" class="cat-trigger mode-trigger" id="mode-trigger">
              <span class="mode-trigger-inner">
                <span class="mode-trigger-icon" id="mode-trigger-icon" aria-hidden="true"></span>
                <span id="mode-trigger-text">Imposter Challenge</span>
              </span>
              <svg class="cat-trigger-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="mode-hint" id="mode-new-hint" role="status" hidden>✨ New game mode is here. Give it a try!</div>
          </div>
          <div class="section-divider" id="mode-music-divider"></div>
          <div class="music-section">
            <!-- One row while the songs come from a category. DJ Mode swaps
                 this out for the two pickers below, which stay full-width:
                 a title and artist has nowhere to go on a right-aligned row
                 and would truncate exactly where it matters. -->
            <button type="button" class="set-row" id="category-trigger">
              <span class="cat-label">Music</span>
              <span class="set-row-value" id="category-trigger-text">TikTok and Reels</span>
              <svg class="cat-trigger-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="mode-hint" id="group-new-hint" role="status" hidden>✨ Now you can create your own song groups.</div>
            <div class="stack-sm song-block" id="song-pick-wrap" style="display:none;">
              <div class="cat-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" fill="currentColor"/><circle cx="18" cy="16" r="3" fill="currentColor"/></svg>
                Songs
              </div>
              <button type="button" class="cat-trigger song-pick-btn" id="pick-crew-btn">
                <span id="pick-crew-text">Pick the group song…</span>
                <svg class="cat-trigger-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="song-pick-row">
                <button type="button" class="cat-trigger song-pick-btn" id="pick-imp-btn">
                  <span id="pick-imp-text">Impostor song (optional)</span>
                  <svg class="cat-trigger-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="song-pick-clear" id="pick-imp-clear" style="display:none;" aria-label="Clear impostor song">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="section-divider" id="imposters-divider"></div>

          <!-- Last row: how many impostors. A setting, so it belongs here with
               the mode and the music rather than in the header of the Players
               card, where it used to sit and read as a fact about the roster.
               Hidden entirely, divider and all, in the group modes, which have
               no impostor at all. -->
          <div class="set-row" id="imposters-section">
            <span class="cat-label">Impostors</span>
            <div class="imposter-pill" id="imposter-info">
              <button id="lobby-imp-minus" type="button" aria-label="Fewer impostors" style="display:none;">−</button>
              <span class="imp-label"><span id="imposter-count-num">1</span> <span id="imposter-count-label">Impostor</span></span>
              <button id="lobby-imp-plus" type="button" aria-label="More impostors" style="display:none;">+</button>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="players-head">
            <div class="label">Players</div>
            <div class="small"><span id="ready-count">0</span> / <span id="player-count">0</span> ready</div>
          </div>
          <div class="players" id="players-list"></div>
        </div>

        <div class="sticky-actions">
          <div class="ready-nudge" id="ready-nudge">
            <button class="btn btn-primary" id="btn-ready">I'm Ready</button>
          </div>
          <button class="btn btn-primary" id="btn-start" disabled>Start Game</button>
          <div class="small center" id="start-hint">Waiting for all players to ready up…</div>
        </div>
      </div>
    </section>

    <!-- GAMEPLAY SCREEN -->
    <section class="screen" id="screen-game">
      <div style="text-align:center;margin-bottom:10px;">
        <div class="imposter-banner" id="imposter-banner" style="display:none;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/><path d="M12 8v5M12 16v.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          You're the Impostor
        </div>
        <div class="small" id="imposter-subhint" style="display:none;margin-top:8px;">Your song is different — blend in and dance like you fit the vibe.</div>
        <div class="gm-banner" id="gm-banner" style="display:none;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
          Game Master
        </div>
        <div class="small" id="gm-subhint" style="display:none;margin-top:8px;"></div>
      </div>
      <div class="gameplay-header">
        <div class="role" id="game-role">NOW PLAYING</div>
        <div class="now-playing" id="game-track">Track —</div>
      </div>

      <div class="dancer-stage">
        <img class="dancer-svg" src="/characterdance.svg" alt="" width="356" height="370" aria-hidden="true" />
      </div>

      <div class="visualizer" id="visualizer"></div>

      <div class="progress-wrap">
        <div class="progress-info">
          <span id="time-current">0:00</span>
          <span id="time-total">1:00</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
      </div>

      <div class="stack-sm" style="margin-top:auto;">
        <button class="btn btn-danger" id="btn-reveal" style="display:none;">End Round</button>
        <div class="small center" id="game-hint">Dance to the song! Watch who's off the vibe.</div>
      </div>
    </section>

    <!-- DISCUSS SCREEN -->
    <section class="screen" id="screen-vote">
      <div style="flex:0.6;min-height:24px;"></div>
      <div class="logo">
        <img class="discuss-art" src="/friends.webp" alt="" width="320" height="320" />
        <h1 id="discuss-title">Find the Impostor</h1>
        <div class="sub" id="discuss-sub">who danced off the vibe?</div>
      </div>

      <div style="flex:1;min-height:16px;"></div>

      <button class="btn btn-danger" id="btn-reveal-now" style="display:none;">Reveal Impostor</button>
      <div class="small center" id="discuss-hint" style="margin-top:10px;"></div>
    </section>

    <!-- FIREBASE SETUP NEEDED SCREEN -->
    <section class="screen" id="screen-needs-setup">
      <button class="back-btn" data-back>← Back</button>
      <div class="logo">
        <h1 style="font-size:24px;">⚙️ Setup Needed</h1>
        <div class="sub">configure firebase</div>
      </div>
      <div class="card stack">
        <p>To enable real multiplayer, add a free Firebase project:</p>
        <ol style="margin-left:20px;line-height:1.8;font-size:14px;color:var(--text-dim);">
          <li>Go to <b style="color:#fff;">console.firebase.google.com</b></li>
          <li>Create a new project</li>
          <li>Build → <b style="color:#fff;">Realtime Database</b> → Create (test mode)</li>
          <li>Project settings → Add <b style="color:#fff;">Web app</b> → copy config</li>
          <li>Paste config into <code style="background:rgba(0,0,0,0.4);padding:2px 6px;border-radius:4px;">FIREBASE_CONFIG</code> at the top of <code style="background:rgba(0,0,0,0.4);padding:2px 6px;border-radius:4px;">index.html</code></li>
        </ol>
        <p class="small">See <b>README.md</b> for full instructions and database security rules.</p>
      </div>
    </section>

    <!-- GAME OVER SCREEN -->
    <section class="screen" id="screen-over">
      <div class="logo">
        <h1>Round Over</h1>
      </div>
      <div class="reveal-sub" id="reveal-sub" style="display:none;"></div>

      <div style="flex:1;min-height:16px;"></div>

      <div class="card reveal-card" id="reveal-card">
        <div class="reveal-line">
          <!-- The noun and the verb are written by revealImposter(), because a
               round can now have up to five impostors. Draw keeps its as static
               markup: it deals exactly one, by design. -->
          <span>The</span><span class="imp-pill" id="reveal-imp-word">Impostor</span><span id="reveal-imp-verb">was</span>
        </div>
        <div class="reveal-name" id="reveal-name">—</div>
      </div>

      <!-- Group modes render their teams here instead of the impostor card. -->
      <div class="reveal-groups" id="reveal-groups" style="display:none;"></div>

      <div class="reveal-extras" id="reveal-extras">
        <div class="track-section">
          <div class="track-label crew">Crewmates heard</div>
          <div class="track-row">
            <div class="track-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9 17V4l12-2v13" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="17" r="3"/><circle cx="18" cy="15" r="3"/></svg>
            </div>
            <div class="track-info">
              <div class="track-title" id="crew-track-title">—</div>
              <div class="track-artist" id="crew-track-artist"></div>
            </div>
          </div>
        </div>

        <div class="track-section">
          <!-- Pluralised by revealImposter() alongside the line above it: they
               all hear the same track, but "Impostor heard" under "THE IMPOSTORS
               WERE" reads as an oversight. -->
          <div class="track-label imp" id="imp-track-label">Impostor heard</div>
          <div class="track-row">
            <div class="track-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9 17V4l12-2v13" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="17" r="3"/><circle cx="18" cy="15" r="3"/></svg>
            </div>
            <div class="track-info">
              <div class="track-title" id="imp-track-title">—</div>
              <div class="track-artist" id="imp-track-artist"></div>
            </div>
          </div>
        </div>
      </div>

      <div style="flex:1;min-height:32px;"></div>

      <div class="stack-sm">
        <button class="btn btn-primary" id="btn-replay">Play Again</button>
        <button class="btn btn-ghost" id="btn-home">Exit Room</button>
      </div>
    </section>
  </div>

  <!-- Countdown overlay -->
  <div class="countdown" id="countdown">
    <div class="num" id="countdown-num">3</div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <!-- Category picker modal -->
  <div class="cat-modal-backdrop" id="cat-modal-backdrop" role="dialog" aria-modal="true" aria-label="Pick music categories">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-select-btn" id="cat-select-btn" type="button">Select</button>
        <button class="cat-modal-close" id="cat-modal-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="cat-hint" id="cat-multi-hint" role="status" hidden>✨ Now you can select multiple categories</div>
      <div class="cat-modal-list" id="cat-modal-list"></div>
      <div class="cat-modal-footer" id="cat-modal-footer" style="display:none;">
        <button class="cat-done" id="cat-modal-done" type="button">Done</button>
      </div>
    </div>
  </div>

  <!-- Game-mode picker modal -->
  <div class="cat-modal-backdrop" id="mode-modal-backdrop" role="dialog" aria-modal="true" aria-label="Pick a game mode">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="mode-modal-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="cat-modal-list" id="mode-modal-list"></div>
    </div>
  </div>

  <!-- Song search modal (Host Picks mode) -->
  <div class="cat-modal-backdrop" id="song-modal-backdrop" role="dialog" aria-modal="true" aria-label="Search for a song">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="song-modal-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="song-search-head">
        <h2 class="fb-title" id="song-modal-title">Pick the group song</h2>
        <input class="fb-field" id="song-search-input" type="search" placeholder="Search song or artist…" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" maxlength="120" />
      </div>
      <div class="cat-modal-list" id="song-search-results"></div>
    </div>
  </div>

  <!-- Song-group builder modal (create/edit a reusable set of songs) -->
  <div class="cat-modal-backdrop" id="group-builder-backdrop" role="dialog" aria-modal="true" aria-label="Create a song group">
    <div class="cat-modal group-builder">
      <div class="cat-modal-header">
        <span class="group-builder-title" id="group-builder-title">Create a song group</span>
        <button class="cat-modal-close" id="group-builder-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="group-builder-body">
        <div class="group-search-wrap">
          <svg class="group-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.6-3.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input class="fb-field group-search-field" id="group-search-input" type="search" placeholder="Search a song to add…" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" maxlength="120" />
          <button class="group-search-clear" id="group-search-clear" type="button" aria-label="Clear search" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="group-mid">
          <div class="group-count-row">
            <span class="group-results-count" id="group-results-count" hidden></span>
            <span class="group-min-hint" id="group-min-hint" hidden>Add at least 4 songs</span>
          </div>
          <div class="cat-modal-list" id="group-search-results"></div>
          <div class="group-selected-list" id="group-selected-list"></div>
        </div>
        <input class="fb-field group-name-field" id="group-name-input" type="text" placeholder="Group name (optional)" maxlength="60" autocomplete="off" />
      </div>
      <div class="cat-modal-footer group-footer">
        <button class="cat-done" id="group-save-btn" type="button" disabled>Save</button>
        <button class="group-trash" id="group-trash-btn" type="button" aria-label="Delete group">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m2 0v12a1 1 0 01-1 1H7a1 1 0 01-1-1V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
        <button class="group-signin-link" id="group-signin-link" type="button">Sign in to save and use anytime.</button>
      </div>
    </div>
  </div>

  <!-- Post-creation fork for signed-out hosts: sign in to keep the new group,
       or continue with a session-only copy. Copy is locked (issue #57). -->
  <div class="cat-modal-backdrop" id="group-saved-backdrop" role="dialog" aria-modal="true" aria-label="Group created">
    <div class="cat-modal choice-sheet">
      <div class="choice-head">
        <img class="group-saved-check" src="/success.webp" alt="" width="120" height="120" />
        <h2 class="choice-title">Group Created!</h2>
        <p class="choice-sub">Your song group is ready.</p>
      </div>
      <button class="cat-done" id="group-saved-signin" type="button">Sign in &amp; Save</button>
      <p class="choice-note">Save it to your account and use it anytime.</p>
      <button class="choice-secondary" id="group-saved-guest" type="button">Continue as Guest</button>
      <p class="choice-note">Available only during this session.</p>
    </div>
  </div>

  <!-- Last chance to keep a guest group: leaving the room clears it. Only
       shown to signed-out hosts who actually have something unsaved. -->
  <div class="cat-modal-backdrop" id="group-lose-backdrop" role="dialog" aria-modal="true" aria-label="Lose your song group?">
    <div class="cat-modal choice-sheet">
      <div class="choice-head">
        <h2 class="choice-title">Lose your song group?</h2>
        <p class="choice-sub">Signing in keeps it for next time.</p>
      </div>
      <button class="cat-done" id="group-lose-signin" type="button">Sign in &amp; Save</button>
      <button class="choice-secondary" id="group-lose-quit" type="button">Quit anyway</button>
    </div>
  </div>


  <!-- Lobby QR popup -->
  <div class="cat-modal-backdrop" id="qr-modal-backdrop" role="dialog" aria-modal="true" aria-label="Room QR code">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="qr-modal-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="qr-modal-body">
        <p class="qr-modal-hint">Scan to join this room</p>
        <div class="qr-card" id="lobby-qr-card"></div>
        <div class="qr-modal-code" id="lobby-qr-code">----</div>
      </div>
    </div>
  </div>

  <!-- How-to-play popup (in-lobby) -->
  <div class="cat-modal-backdrop" id="howto-modal-backdrop" role="dialog" aria-modal="true" aria-label="How to play">
    <div class="cat-modal">
      <div class="cat-modal-header">
        <h2 class="cat-modal-title">How to play</h2>
        <button class="cat-modal-close" id="howto-modal-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="cat-modal-list" id="howto-modal-body"></div>
    </div>
  </div>

  <!-- Round-milestone feedback popup -->
  <div class="cat-modal-backdrop" id="fbp-backdrop" role="dialog" aria-modal="true" aria-label="Enjoying the game?">
    <div class="cat-modal fbp-card">
      <div class="cat-modal-header">
        <button class="cat-modal-close" id="fbp-close" type="button" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="fbp-body">
        <div class="fbp-title" id="fbp-title">Enjoying the game? 🎉</div>
        <div class="fb-emojis" id="fb-emojis">
          <button type="button" class="fb-emoji" data-rating="1" aria-label="Not great">😕</button>
          <button type="button" class="fb-emoji" data-rating="2" aria-label="It's okay">😐</button>
          <button type="button" class="fb-emoji" data-rating="3" aria-label="Good">😄</button>
          <button type="button" class="fb-emoji" data-rating="4" aria-label="Love it">🤩</button>
        </div>
        <button type="button" class="feedback-link" id="fb-prompt-link">Tell us what you think</button>
      </div>
    </div>
  </div>

  <!-- Audio-blocked overlay. Copy is swapped by showAudioOverlay(): the
       browser blocking autoplay and the song failing to load both leave the
       player silent, and both are fixed by the same tap. -->
  <div class="audio-overlay" id="audio-overlay" role="button" aria-label="Tap to start the music">
    <div class="audio-overlay-card">
      <div class="audio-overlay-icon" id="audio-overlay-icon">🔇</div>
      <div class="audio-overlay-title" id="audio-overlay-title">Tap to start the music</div>
      <div class="audio-overlay-sub" id="audio-overlay-sub">Your browser paused the song. One tap and you'll drop in, right in sync with everyone else.</div>
    </div>
  </div>

  <!-- Audio elements -->
  <audio id="audio-player" preload="auto" playsinline></audio>

<!-- qrcode-generator v1.4.4 by Kazuhiko Arase (MIT) — vendored in shared/qrcode.js, no runtime CDN dependency. Exposes window.qrcode. -->
<script src="../shared/qrcode.js"></script>
<script src="../shared/press.js"></script>
<script type="module" src="app.js"></script>
</body>
</html>
