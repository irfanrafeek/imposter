{% from "components/head.njk" import head %}
{% from "components/faq.njk" import faq, faqJsonLd %}
{% from "components/more-reading.njk" import moreReading %}
{% from "components/jsonld.njk" import graph %}
{% from "components/lang-switch.njk" import langSwitch %}
<!DOCTYPE html>
<html lang="{{ locale.lang }}">
<head>
{{ head(c.head, page, site, url, locale, alternates, defaultUrl, manifestHref) }}
<script>
  // Legacy deep links: QR codes and shared links from before the hub existed
  // point at impostorgames.com/?join=CODE — those rooms are dance-game rooms,
  // so forward them before anything renders.
  (function () {
    var m = location.search.match(/[?&]join=([A-Za-z0-9]{1,8})/);
    if (m) location.replace('/dance/?join=' + encodeURIComponent(m[1]));
  })();
</script>
<style>
  /* Palette comes from shared/tokens.css, linked above (#128).
     The hub used to carry a hand-copied subset of it inline, which is
     how the one value below drifted out of step without anyone noticing.

     --radius-lg is 28px here against the shared 26px. Kept deliberately:
     reconciling it changes how the game cards actually look, which is a
     visual decision and not part of a plumbing change. Filed as #142. */
  :root {
    --radius-lg: 28px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    color: var(--ink);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }
  .wrap { max-width: 560px; margin: 0 auto; padding: 48px 22px 40px; }

  /* Load-in stagger: heading → tagline → first card → second card.
     transform/opacity only (compositor-friendly); skipped entirely for
     users who prefer reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1, .hero .tagline, .games .game-card {
      opacity: 0;
      animation: riseIn 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
    }
    .hero .tagline { animation-delay: 0.12s; }
    .games .game-card:nth-child(1) { animation-delay: 0.24s; }
    .games .game-card:nth-child(2) { animation-delay: 0.38s; }
    .games .game-card:nth-child(3) { animation-delay: 0.52s; }
  }
  @keyframes riseIn {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero { text-align: center; margin-top: 24px; margin-bottom: 24px; }
  .hero h1 {
    font-family: 'Literata', Georgia, serif;
    font-weight: 400;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }
  .hero .tagline {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 16px;
    max-width: 360px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Game cards — big illustration + title + dark pill Play button */
  .games { display: flex; flex-direction: column; gap: 24px; }
  .hub-topbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 4px 2px 0; min-height: 34px; }
  /* Language switcher. A COPY of the rules in shared/base.css, which this
     page does not load; the two have to be changed together (#128, #139).
     One rule is left out: the menu opens to the left edge here, because on
     the hub the switcher IS the left-hand item. */
  .lang-switch {
      position: relative;
      flex-shrink: 0;
    }

  .lang-switch > summary {
      list-style: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      color: var(--ink-soft);
      white-space: nowrap;
    }

  .lang-switch > summary::-webkit-details-marker { display: none; }

  .lang-switch > summary:active { background: var(--bg-soft); }

  .lang-switch[open] > summary { color: var(--ink); background: var(--bg-soft); }

  .lang-globe { flex-shrink: 0; opacity: 0.75; }

  /* The chevron, same construction as the FAQ's so the two rotate alike. */
  .lang-switch > summary::after {
      content: '';
      width: 6px; height: 6px;
      border-right: 1.8px solid var(--ink-soft);
      border-bottom: 1.8px solid var(--ink-soft);
      transform: rotate(45deg) translate(-1px, -1px);
      transition: transform 0.2s;
      flex-shrink: 0;
    }

  .lang-switch[open] > summary::after { transform: rotate(-135deg) translate(-1px, -1px); }

  .lang-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 30;
      min-width: 100%;
      margin: 0;
      padding: 6px;
      list-style: none;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }


  .lang-opt {
      display: block;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 500;
      color: var(--ink-soft);
      text-decoration: none;
      white-space: nowrap;
    }

  .lang-opt.is-current {
      background: var(--bg-soft);
      color: var(--ink);
    }

  a.lang-opt:active { background: var(--bg-soft); color: var(--ink); }
  .account-slot { display: flex; align-items: center; }
  a.game-card {
    display: block;
    position: relative;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 24px 24px 28px;
    text-decoration: none;
    color: var(--ink);
    text-align: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.game-card:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(42,37,32,0.10); }
  /* Press feedback. The cards' entrance animation uses forwards fill, which
     pins their transform, so a scale on the card can't render — we press the
     card by flattening its shadow (settles into the page) and let the Play
     pill do the visible "click". Both are on properties the animation leaves
     alone. .is-pressed is driven by shared/press.js for reliable touch. */
  a.game-card:active,
  a.game-card.is-pressed {
    box-shadow: 0 1px 5px rgba(42,37,32,0.10);
    transition: box-shadow 0.06s ease;
  }
  a.game-card:active .play-btn,
  a.game-card.is-pressed .play-btn {
    transform: scale(0.96);
    filter: brightness(0.9);
    transition: transform 0.06s ease, filter 0.06s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    a.game-card:active .play-btn,
    a.game-card.is-pressed .play-btn { transform: none; }
  }
  .game-card .art-frame {
    background: var(--bg);
    border-radius: 20px;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .game-card .art {
    display: block;
    width: 75%;
    max-width: 320px;
    height: auto;
    aspect-ratio: 5 / 3;
    object-fit: contain;
  }
  /* Title and blurb are left-aligned inside an otherwise centred card. The
     artwork above and the Play button below stay centred, so the text block
     reads as a caption sitting under the illustration rather than as more
     card furniture. */
  .game-card h2 {
    font-family: 'Literata', Georgia, serif;
    font-weight: 400;
    font-size: 24px;
    margin: 16px 0 4px;
    letter-spacing: -0.2px;
    text-align: left;
  }
  /* One line saying what the game actually is. The three titles all start with
     "Impostor", so without this the only thing telling the cards apart is the
     artwork. The 20px that used to sit under the h2 lives here now, so the
     card grows by the height of the line and nothing else. */
  .game-card .blurb {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0 0 12px;
    text-align: left;
  }

  /* Dark pill button — matches the primary CTA style used in the apps */
  .game-card .play-btn {
    display: inline-block;
    background: var(--card-active);
    color: var(--ink-on-dark);
    font-weight: 600;
    font-size: 15px;
    border-radius: 999px;
    padding: 14px 44px;
    min-width: 160px;
    letter-spacing: 0.2px;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
  }

  /* Clear separation between the games and the SEO content below */
  .about-divider {
    margin: 64px auto 32px;
    max-width: 240px;
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink-faint);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .about-divider::before, .about-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  section.info { margin-bottom: 44px; }
  /* Left-aligned, unlike the "ABOUT THE GAMES" eyebrow above. Everything in
     these sections is prose, and centred prose gives the eye a new left edge
     to find on every line. The eyebrow is a label, not reading, so it stays
     centred. Mirrors .howto-header and .howto-def in shared/base.css. */
  section.info h2 {
    font-family: 'Literata', Georgia, serif;
    font-weight: 400;
    font-size: 24px;
    text-align: left;
    margin-bottom: 14px;
  }
  section.info p.def {
    color: var(--ink-soft);
    font-size: 14.5px;
    line-height: 1.65;
    text-align: left;
  }
  section.info p.def strong { color: var(--ink); font-weight: 600; }
  section.info .more {
    display: block;
    text-align: left;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-teal);
    text-decoration: none;
  }
  section.info .more:hover { text-decoration: underline; }

  /* The guides list under its own heading, mirroring the block the game
     pages carry under their FAQ. Restated here rather than shared, because
     this page does not load shared/base.css: change one, change the other.
     Set as prose in Literata with the teal underline the content pages use
     on their body links, so a link looks like the page it leads to. */
  .more-reading {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .more-reading a {
    display: inline-block;
    padding: 4px 0;
    font-family: 'Literata', Georgia, serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent-teal);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 44px 16px 18px;
    font-weight: 600;
    font-size: 14.5px;
    position: relative;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '';
    position: absolute;
    right: 20px;
    top: 20px;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-faint);
    border-bottom: 2px solid var(--ink-faint);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }
  .faq-item[open] summary::after { transform: rotate(-135deg); }
  .faq-item p {
    padding: 0 18px 16px;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  footer {
    text-align: center;
    color: var(--ink-faint);
    font-size: 12px;
    line-height: 1.8;
    padding: 20px 0 8px;
  }
  footer a { color: var(--ink-soft); }
  /* Version stamp — deliberately faint and small; there for dev cache-bust
     verification but out of the way for regular visitors. */
  .version {
    margin-top: 14px;
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--ink-faint);
    opacity: 0.5;
  }
</style>
<script type="application/ld+json">
{{ graph(c.jsonldGraph, faqJsonLd(c.faq)) | safe }}
</script>
</head>
<body>
  <div class="wrap">
    <div class="hub-topbar">
{{ langSwitch(alternates, t('lang.switcher-label')) }}
      <div id="account-slot" class="account-slot"></div>
    </div>
    <header class="hero">
      <h1>{{ c.hero.h1 | safe }}</h1>
      <p class="tagline">{{ c.hero.tagline | safe }}</p>
    </header>

    <main class="games">
{% for card in c.cards %}
      <a class="game-card {{ card.cls }}" href="{{ card.href }}">
        <div class="art-frame">
          <img class="art" src="{{ card.img }}" alt="{{ card.alt | safe }}" width="{{ card.width }}" height="{{ card.height }}" loading="{{ card.loading }}" />
        </div>
        <h2>{{ card.h2 | safe }}</h2>
        <p class="blurb">{{ card.blurb | safe }}</p>
        <span class="play-btn">{{ card.play | safe }}</span>
      </a>
{% endfor %}
    </main>

    <div class="about-divider">{{ c.aboutDivider | safe }}</div>

    {% for block in c.info %}
    <section class="info">
      <h2>{{ block.h2 | safe }}</h2>
      <p class="def">{{ block.def | safe }}</p>
      <a class="more" href="{{ block.href }}">{{ block.more | safe }}</a>
    </section>
{% endfor %}

    <section class="info">
      <h2>{{ c.faq.heading | safe }}</h2>
      {{ faq(c.faq.visible) }}
    </section>

    {# Optional. The long-form guides are English-only, so /es/ leaves the
       whole block out rather than sending a Spanish reader to a page they
       cannot read. It comes back the day there is a Spanish guide (#139). #}
{% if c.guides %}
    <section class="info">
      <h2>{{ c.guides.h2 | safe }}</h2>
      {{ moreReading(c.guides.links) }}
    </section>
{% endif %}

    <footer>
      {{ c.footer.line | safe }}<br />
{% for link in c.footer.links %}
      <a href="{{ link.href }}">{{ link.label | safe }}</a>{{ " · " if not loop.last }}
{% endfor %}
      <div class="version" id="app-version">{{ site.version }}</div>
    </footer>
  </div>

  <script src="/shared/press.js"></script>
  {% include "components/i18n.njk" %}
  <script type="module">
    // Cookie-free hub analytics: visits only, under analytics/hub. Same
    // counter kit as the games (shared/analytics.js), own session key so
    // the hub stays a separate funnel entry from the games.
    import { createAnalytics, peekGeo } from "/shared/analytics.js";
    import { initAuthUI, mountAccountButton } from "/shared/auth-ui.js";
    import { db } from "/shared/firebase.js";
    import { mountChat } from "/shared/chat.js";
    import { createSupportTransport } from "/shared/chat-support.js";
    import { t } from "/shared/i18n.js";

    const analytics = createAnalytics('hub');
    analytics.trackSession('imp_hub_sess');

    // Hub-level account button. Sign-in is optional and gates nothing here — it
    // lets returning organizers manage the account whose Song Groups they reuse.
    initAuthUI();
    mountAccountButton(document.getElementById('account-slot'));

    // Talk to creator. The hub gets the sticky button; the three games
    // open the same panel from the quiet link in their home footer.
    if (db) {
      const transport = createSupportTransport({
        db,
        role: 'user',
        source: 'hub',
        meta: () => ({
          version: (document.getElementById('app-version') || {}).textContent || null,
          country: (peekGeo() && peekGeo().country) || null,
          countryCode: (peekGeo() && peekGeo().cc) || null,
        }),
      });

      const chat = mountChat({
        transport,
        launcher: 'sticky',
        title: t('chat.title'),
        opener: t('chat.opener'),
        placeholder: t('chat.placeholder'),
        me: 'user',
        onOpen: () => analytics.bumpAnalytics({ 'chat/opened': 1 }),
        onSend: () => analytics.bumpAnalytics({ 'chat/sent': 1 }),
      });

      // Returning visitor with a reply waiting: light the dot before they open
      // anything. No-ops for anyone without a thread, so first-time visitors
      // never make this request.
      transport.hasUnread().then((yes) => {
        if (!yes) return;
        chat.setUnread(1);
        analytics.bumpAnalytics({ 'chat/reply_waiting': 1 });
      });
    }
  </script>
</body>
</html>
