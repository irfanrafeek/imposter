{
  "rules": {
    "rooms": {
      ".read": false,
      ".write": false,
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "rooms-word": {
      ".read": false,
      ".write": false,
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "analytics": {
      ".read": true,
      ".write": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "feedback": {
      ".read": false,
      ".write": true
    }
  }
}
